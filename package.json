{
  "name": "TownPulseMobileAuth",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "powershell -ExecutionPolicy Bypass -File .\\scripts\\run-android.ps1",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "prestart": "powershell -ExecutionPolicy Bypass -File .\\scripts\\ensure-mongodb.ps1 && powershell -ExecutionPolicy Bypass -File .\\scripts\\clear-stale-backend.ps1",
    "start": "concurrently -k -n BACKEND,METRO -c yellow,cyan \"npm --prefix ../.. run dev\" \"react-native start\"",
    "start:backend": "npm --prefix ../.. run dev",
    "start:metro": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-documents/picker": "^12.0.1",
    "@react-native-firebase/app": "24.0.0",
    "@react-native-firebase/auth": "24.0.0",
    "@react-native-firebase/messaging": "^24.0.0",
    "@react-native-google-signin/google-signin": "16.1.2",
    "jspdf": "^4.2.1",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-blob-util": "^0.24.7",
    "react-native-fs": "^2.20.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-maps": "^1.27.2",
    "react-native-razorpay": "^3.0.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-share": "^12.3.1",
    "react-native-webview": "^13.16.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/eslint-config": "0.85.0",
    "@react-native/jest-preset": "0.85.0",
    "@react-native/metro-config": "0.85.0",
    "@react-native/typescript-config": "0.85.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "concurrently": "9.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
